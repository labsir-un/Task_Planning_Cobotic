import "block.cif";

red1: red(7,8);
blue1: blue(6,7);
green1: green(6,9);
black1: black(5,9);
black2: black(6,5);
black3: black(6,6);
black4: black(6,8);

requirement avoidCollision:
    alg set tuple(int x,y) occupied = {
        (red1.x, red1.y),
        (blue1.x, blue1.y),
        (green1.x, green1.y),
        (black1.x, black1.y),
        (black2.x, black2.y),
        (black3.x, black3.y),
        (black4.x, black4.y)
    };

    location:
        initial;
        requirement invariant size(occupied) = 7;
end
